{
  "manifest_version": 3,
  "name": "Language Fly",
  "version": "1.0.0",
  "description": "Learn vocabulary while browsing webpages.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.wikipedia.org/*",
    "https://wikipedia.org/*",
    "https://*.bbc.com/*",
    "https://bbc.com/*",
    "https://*.bbc.co.uk/*",
    "https://bbc.co.uk/*",
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.wikipedia.org/*",
        "https://wikipedia.org/*",
        "https://*.bbc.com/*",
        "https://bbc.com/*",
        "https://*.bbc.co.uk/*",
        "https://bbc.co.uk/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}